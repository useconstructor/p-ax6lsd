        "type": "workflow",
        "target": "check_status"
      },
      "attributes": {},
      "styles": {}
    },
    {
      "path": "/",
      "selector": "body:nth-of-type(1) > main:nth-of-type(1) > section:nth-of-type(1) > figure:nth-of-type(1) > img:nth-of-type(1)",
